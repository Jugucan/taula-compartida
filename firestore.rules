rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Superadministradora de l'app (User UID de Firebase Authentication).
    function isSuperAdmin() {
      return signedIn() && request.auth.uid == 'gZ3EwJqzPNUMVpNaUjWu9pAWwRl2';
    }

    // Organitzador aprovat per la superadministradora i no suspès.
    function isActiveOrganizer() {
      return signedIn()
        && exists(/databases/$(database)/documents/organizers/$(request.auth.uid))
        && get(/databases/$(database)/documents/organizers/$(request.auth.uid)).data.status == 'active';
    }

    // Cadascú només pot treballar en el SEU espai, i només si és superadministradora o organitzador actiu.
    function canUseWorkspace(wsId) {
      return signedIn() && request.auth.uid == wsId && (isSuperAdmin() || isActiveOrganizer());
    }

    // Interruptor de sol·licituds: la superadministradora el pot obrir o tancar.
    function requestsOpen() {
      return exists(/databases/$(database)/documents/config/access)
        && get(/databases/$(database)/documents/config/access).data.requestsOpen == true;
    }

    match /workspaces/{wsId} {
      allow read, write: if canUseWorkspace(wsId);

      match /restaurants/{restaurantId} {
        allow read, write: if canUseWorkspace(wsId);

        match /menus/{menuId} {
          allow read, write: if canUseWorkspace(wsId);
        }
      }

      match /events/{eventId} {
        allow read, write: if canUseWorkspace(wsId);

        // Les comandes només es poden llegir; les escriu el servidor.
        match /orders/{orderId} {
          allow read: if canUseWorkspace(wsId);
        }
      }
    }

    // Organitzadors admesos. Cadascú pot veure el seu; només la superadministradora els crea, canvia o suspèn.
    match /organizers/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if isSuperAdmin();
    }

    // Sol·licituds d'accés: cadascú només pot crear la seva (i només si les sol·licituds estan obertes).
    match /organizerRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && requestsOpen()
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isSuperAdmin();
    }

    // Configuració: només es pot llegir el commutador d'accés (és públic); només la superadministradora el canvia.
    match /config/{docId} {
      allow read: if docId == 'access';
      allow write: if isSuperAdmin();
    }

    // Enllaços públics: només es creen cap al SEU espai i només si es té permís. Ningú els llegeix des del navegador.
    match /links/{code} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['wsId', 'eventId'])
        && request.resource.data.wsId == request.auth.uid
        && request.resource.data.eventId is string
        && (isSuperAdmin() || isActiveOrganizer());
      allow delete: if signedIn()
        && resource.data.wsId == request.auth.uid
        && (isSuperAdmin() || isActiveOrganizer());
      allow read, update: if false;
    }

    // Qualsevol altra cosa: prohibida.
  }
}
